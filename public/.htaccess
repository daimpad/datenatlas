# Serve JSON with correct MIME type
<IfModule mod_mime.c>
  AddType application/json .json
</IfModule>

# Disable directory listing
Options -Indexes

# Allow cross-origin for data files (if needed by browser)
<IfModule mod_headers.c>
  <FilesMatch "\.json$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>
